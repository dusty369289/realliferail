# Real Life Rail, kept running for your phone. Installed by scripts/phone-setup.sh.
# Listens on this machine only. Your phone reaches it through Tailscale (realliferail-tailscaled.service).
[Unit]
Description=Real Life Rail (live train tracker)
After=network-online.target

[Service]
WorkingDirectory=%h/Projects/realliferail
ExecStart=%h/Projects/realliferail/.venv/bin/realliferail serve --port 8765
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
